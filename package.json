{
  "name": "typelytics",
  "displayName": "Typelytics",
  "description": "Track typing patterns and analytics",
  "publisher": "orace227",
  "version": "1.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Orace227/Typelytics.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "typingAnalyticsSidebar",
          "title": "Typelytics",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "typingAnalyticsSidebar": [
        {
          "id": "typingAnalyticsView",
          "name": "Typelytics",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "typingAnalyticsView",
        "contents": "📊 Welcome to Typelytics!\nTrack your coding patterns and productivity.\n[Open Dashboard](command:typingAnalytics.showDashboard)"
      }
    ],
    "commands": [
      {
        "command": "typingAnalytics.showDashboard",
        "title": "📊 Show Analytics Dashboard",
        "category": "Typelytics"
      },
      {
        "command": "typingAnalytics.showSidebar",
        "title": "📈 Show Analytics Sidebar",
        "category": "Typelytics"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "typingAnalytics.showDashboard",
          "when": "view == typingAnalyticsView",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "typingAnalytics.showSidebar",
          "title": "📈 Typelytics: Show Sidebar"
        }
      ]
    },
    "configuration": {
      "title": "Typelytics",
      "properties": {
        "typingAnalytics.showDailyPopup": {
          "type": "boolean",
          "default": true,
          "description": "Show daily summary popup"
        },
        "typingAnalytics.trackingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable typing tracking"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
