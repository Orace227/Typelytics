{
  "name": "typelytics",
  "displayName": "Typelytics",
  "description": "Track typing patterns and analytics",
  "publisher": "orace227",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Orace227/Typelytics.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "typingAnalytics.showDashboard",
        "title": "Show Typing Analytics Dashboard"
      },
      {
        "command": "typingAnalytics.clearData",
        "title": "Clear Analytics Data"
      }
    ]
  },
  "configuration": {
    "title": "Typelytics",
    "properties": {
      "typingAnalytics.enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable typing analytics tracking"
      },
      "typingAnalytics.excludePatterns": {
        "type": "array",
        "default": [
          "**/*.log",
          "**/node_modules/**"
        ],
        "description": "File patterns to exclude from tracking"
      },
      "typingAnalytics.showDailyPopup": {
        "type": "boolean",
        "default": true,
        "description": "Show daily analytics popup"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
